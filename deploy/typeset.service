[Unit]
Description=Typeset font sync server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/typeset-server
EnvironmentFile=/etc/typeset/typeset.env
# The database and uploaded fonts live in /var/lib/typeset (StateDirectory).
Environment=TYPESET_DATA_DIR=/var/lib/typeset
StateDirectory=typeset
WorkingDirectory=/var/lib/typeset
Restart=on-failure
RestartSec=2

# Unprivileged throwaway user; only allowed to bind ports below 1024.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
