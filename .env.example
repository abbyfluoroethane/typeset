# Typeset server configuration. Copy to .env or set in your service manager.
#
# Only the first block is needed to start. Open the server in a browser to
# finish setup: the page asks for the setup token that the server prints to
# its log, then walks through the rest.

# Where the server listens.
TYPESET_BIND=0.0.0.0:8080

# SQLite database and uploaded font files live here.
TYPESET_DATA_DIR=data
# TYPESET_DATABASE_URL=sqlite://data/typeset.db?mode=rwc

# How long the cached Google Fonts catalog stays fresh (seconds).
TYPESET_CATALOG_TTL_SECS=21600
# Largest accepted font upload (bytes).
TYPESET_MAX_UPLOAD_BYTES=33554432

# --- Optional: settings the setup page can also manage -------------------
# A value set here wins over the one saved from the page, and the page
# shows it as read-only. Leave these commented out to manage them there.

# The URL clients and your identity provider use to reach the server.
# Register <TYPESET_PUBLIC_URL>/auth/callback as the redirect URI.
# TYPESET_PUBLIC_URL=https://fonts.example.com

# Bring your own OIDC provider (Authentik, Keycloak, Pocket ID, Authelia...).
# TYPESET_OIDC_ISSUER=https://auth.example.com/application/o/typeset/
# TYPESET_OIDC_CLIENT_ID=typeset
# Leave unset if the client is registered as public.
# TYPESET_OIDC_CLIENT_SECRET=
# Comma-separated allowlist. Unset lets in anyone your IdP lets in.
# TYPESET_ALLOWED_EMAILS=

# https://developers.google.com/fonts/docs/developer_api
# TYPESET_GOOGLE_FONTS_API_KEY=
